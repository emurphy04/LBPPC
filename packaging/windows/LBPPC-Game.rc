#include <winuser.h>
#include <winver.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "LBPPC-Game.manifest"

// What Windows shows for the game: Task Manager, the firewall prompt, Properties. Shipped as LBPPC-Game.exe.
1 ICON "../../launcher/assets/lbppc.ico"

1 VERSIONINFO
FILEVERSION 0,1,3,0
PRODUCTVERSION 0,1,3,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LBPPC"
            VALUE "FileDescription", "LBPPC (LittleBigPlanet 3)"
            VALUE "FileVersion", "0.1.3"
            VALUE "InternalName", "LBPPC-Game"
            VALUE "OriginalFilename", "LBPPC-Game.exe"
            VALUE "ProductName", "LBPPC"
            VALUE "ProductVersion", "0.1.3"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Not affiliated with Sony Interactive Entertainment."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
