# /etc/lbppc/refresh-login-check.env (chmod 600, owned by root): read by systemd for Refresh.
# shadNet's admin API on this machine; "off" turns the login check and the sign-up name check off (a private test
# server only: anyone could then sign in as anyone).
LBPPC_SHADNET_CHECK_URL=http://127.0.0.1:31350/admin/v1/sessions/check
# shadNet's AdminApiKey (shadnet.cfg). Change both together.
LBPPC_SHADNET_KEY=
# 1: every game login needs a sign-in code (LBPPC 0.1.3 and later); 0.1.2 and earlier are refused. Until then logins
# without a code are let in only while the account is signed in to shadNet from the same address.
LBPPC_REQUIRE_LOGIN_CODE=0
