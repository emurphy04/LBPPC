diff -ruN a/src/lbppc_guard.h b/src/lbppc_guard.h
--- a/src/lbppc_guard.h	1969-12-31 20:30:00.000000000 -0330
+++ b/src/lbppc_guard.h	2026-11-13 11:21:20.711430600 -0330
@@ -0,0 +1,84 @@
+// LBPPC: limits on password guessing and sign-ups, per player address (ClientSession::PeerIp, the player's own
+// address through nginx) and per account name. In memory: a restart clears them.
+//   wrong passwords within 15 minutes -> refused for 15 minutes: 10 for one account from one address, 20 from one
+//   address (any accounts), 50 for one account from anywhere. A troll can't lock someone out with a few tries
+//   (the lock is per address), and guessing spread over many addresses still stops.
+//   new accounts: 3 per address per 24 hours
+#pragma once
+
+#include <algorithm>
+#include <QDateTime>
+#include <QHash>
+#include <QList>
+#include <QMutex>
+#include <QString>
+
+namespace LbppcGuard {
+
+constexpr qint64 FailureWindowMs = 15 * 60 * 1000;
+constexpr int MaxFailuresPerAccountFromAddress = 10;
+constexpr int MaxFailuresPerAccount = 50;
+constexpr int MaxFailuresPerAddress = 20;
+constexpr qint64 SignupWindowMs = 24 * 60 * 60 * 1000;
+constexpr int MaxSignupsPerAddress = 3;
+constexpr int MinPasswordLength = 8; // the launcher's (scripts/online_accounts.py MIN_PASSWORD)
+
+struct State {
+    QMutex mutex;
+    QHash<QString, QList<qint64>> failuresByAccount, failuresByPair, failuresByAddress, signupsByAddress;
+};
+
+inline State& Get() {
+    static State state;
+    return state;
+}
+
+// The times within the window, older ones dropped (and the key removed when none are left).
+inline int Recent(QHash<QString, QList<qint64>>& table, const QString& key, qint64 window, qint64 now) {
+    auto it = table.find(key);
+    if (it == table.end())
+        return 0;
+    it->erase(std::remove_if(it->begin(), it->end(), [&](qint64 t) { return now - t > window; }), it->end());
+    if (it->isEmpty()) {
+        table.erase(it);
+        return 0;
+    }
+    return int(it->size());
+}
+
+// Whether a login for this account from this address is refused for now (too many wrong passwords).
+inline bool LoginLocked(const QString& address, const QString& account) {
+    auto& s = Get();
+    QMutexLocker lock(&s.mutex);
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    const QString name = account.toLower();
+    return Recent(s.failuresByPair, name + QLatin1Char('|') + address, FailureWindowMs, now) >=
+               MaxFailuresPerAccountFromAddress ||
+           Recent(s.failuresByAddress, address, FailureWindowMs, now) >= MaxFailuresPerAddress ||
+           Recent(s.failuresByAccount, name, FailureWindowMs, now) >= MaxFailuresPerAccount;
+}
+
+inline void LoginFailed(const QString& address, const QString& account) {
+    auto& s = Get();
+    QMutexLocker lock(&s.mutex);
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    const QString name = account.toLower();
+    s.failuresByAccount[name].append(now);
+    s.failuresByPair[name + QLatin1Char('|') + address].append(now);
+    s.failuresByAddress[address].append(now);
+}
+
+inline bool SignupAllowed(const QString& address) {
+    auto& s = Get();
+    QMutexLocker lock(&s.mutex);
+    return Recent(s.signupsByAddress, address, SignupWindowMs, QDateTime::currentMSecsSinceEpoch()) <
+           MaxSignupsPerAddress;
+}
+
+inline void SignedUp(const QString& address) {
+    auto& s = Get();
+    QMutexLocker lock(&s.mutex);
+    s.signupsByAddress[address].append(QDateTime::currentMSecsSinceEpoch());
+}
+
+} // namespace LbppcGuard
diff -ruN a/src/lbppc_names.h b/src/lbppc_names.h
--- a/src/lbppc_names.h	1969-12-31 20:30:00.000000000 -0330
+++ b/src/lbppc_names.h	2026-11-13 11:21:20.732978600 -0330
@@ -0,0 +1,144 @@
+// LBPPC: names nobody can register (shadNet accounts, and Refresh, which asks shadNet: GET /admin/v1/names/check).
+// The list is a text file, /etc/lbppc/blocked-names.txt (LBPPC_BLOCKED_NAMES overrides), read again whenever it
+// changes; its format is described in the file. name_check.py (beside the deploy scripts) is the same rule in
+// Python, for testing a list against names: keep the two the same.
+//
+// A name is lower-cased, leetspeak undone (0 o, 1 i, 3 e, 4 a, 5 s, 7 t, 8 b, @ a, $ s, ! i, | i) and reduced to
+// letters. A list word matches when its letters appear in order with each run of a letter at least as long as in the
+// word: "faggot" matches faaaggot and fagggot, while "nigg" needs two g's and so doesn't match knight.
+#pragma once
+
+#include <QDateTime>
+#include <QDebug>
+#include <QFile>
+#include <QFileInfo>
+#include <QMutex>
+#include <QRegularExpression>
+#include <QString>
+#include <QStringList>
+#include <QTextStream>
+
+namespace LbppcNames {
+
+inline QString Squash(const QString& name) {
+    static const QString from = QStringLiteral("0134578@$!|");
+    static const QString to = QStringLiteral("oieastbasii");
+    QString out;
+    out.reserve(name.size());
+    for (QChar c : name.toLower()) {
+        const int i = from.indexOf(c);
+        if (i >= 0)
+            c = to.at(i);
+        if (c >= QLatin1Char('a') && c <= QLatin1Char('z'))
+            out.append(c);
+    }
+    return out;
+}
+
+// Each run of a letter as that letter at least as many times: "fagg" -> "f{1,}a{1,}g{2,}".
+inline QString Pattern(const QString& word) {
+    QString out;
+    for (int i = 0; i < word.size();) {
+        int run = 1;
+        while (i + run < word.size() && word.at(i + run) == word.at(i))
+            ++run;
+        out += QRegularExpression::escape(QString(word.at(i))) + QStringLiteral("{%1,}").arg(run);
+        i += run;
+    }
+    return out;
+}
+
+struct Entry {
+    QString label;            // the word as listed ("=word" for a whole-name entry)
+    QString digits;           // a number entry (1488): matched in the name as typed
+    QRegularExpression rule;  // otherwise: matched in the squashed name
+};
+
+struct Rules {
+    QList<Entry> entries;
+    QStringList allowed;
+};
+
+inline Rules Parse(QTextStream& in) {
+    Rules rules;
+    while (!in.atEnd()) {
+        QString line = in.readLine().trimmed().toLower();
+        if (line.isEmpty() || line.startsWith(QLatin1Char('#')))
+            continue;
+        if (line.startsWith(QLatin1Char('+'))) {
+            const QString word = Squash(line.mid(1));
+            if (!word.isEmpty())
+                rules.allowed.append(word);
+            continue;
+        }
+        const bool exact = line.startsWith(QLatin1Char('='));
+        if (exact)
+            line = line.mid(1);
+        bool isNumber = false;
+        line.toLongLong(&isNumber);
+        if (isNumber) {
+            rules.entries.append({line, line, {}});
+            continue;
+        }
+        const QString word = Squash(line);
+        if (word.isEmpty())
+            continue;
+        const QString pattern = exact ? QRegularExpression::anchoredPattern(Pattern(word)) : Pattern(word);
+        rules.entries.append({exact ? QLatin1Char('=') + word : word, {}, QRegularExpression(pattern)});
+    }
+    return rules;
+}
+
+// The list entry that blocks the name, or an empty string.
+inline QString BlockedBy(const QString& name, const Rules& rules) {
+    QString squashed = Squash(name);
+    for (const QString& word : rules.allowed)
+        squashed.remove(word);
+    const QString raw = name.toLower();
+    for (const Entry& e : rules.entries) {
+        if (!e.digits.isEmpty()) {
+            if (raw.contains(e.digits))
+                return e.label;
+        } else if (e.rule.match(squashed).hasMatch()) {
+            return e.label;
+        }
+    }
+    return {};
+}
+
+// The file's rules, read again when it changes. If it can't be read, every new name is refused (fails closed:
+// a missing list must not let anything through); the reason is logged.
+inline QString BlockedBy(const QString& name) {
+    static QMutex mutex;
+    static Rules rules;
+    static QDateTime loadedAt;
+    static bool warned = false;
+    const QByteArray env = qgetenv("LBPPC_BLOCKED_NAMES");
+    const QString path = env.isEmpty() ? QStringLiteral("/etc/lbppc/blocked-names.txt") : QString::fromUtf8(env);
+    QMutexLocker lock(&mutex);
+    const QFileInfo info(path);
+    if (!info.exists() || !info.isReadable()) {
+        if (!warned)
+            qCritical() << "LBPPC: the blocked-names list" << path
+                        << "can't be read (missing, or permissions): every new name is refused until it can";
+        warned = true;
+        loadedAt = {};
+        return QStringLiteral("(the blocked-names list can't be read)");
+    }
+    if (info.lastModified() != loadedAt) {
+        QFile file(path);
+        if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            qCritical() << "LBPPC: the blocked-names list" << path << "can't be opened: every new name is refused";
+            return QStringLiteral("(the blocked-names list can't be read)");
+        }
+        QTextStream in(&file);
+        rules = Parse(in);
+        loadedAt = info.lastModified();
+        warned = false;
+        qInfo() << "LBPPC: blocked-names list loaded:" << rules.entries.size() << "entries,"
+                << rules.allowed.size() << "allowed words";
+    }
+    return BlockedBy(name, rules);
+}
+
+} // namespace LbppcNames
