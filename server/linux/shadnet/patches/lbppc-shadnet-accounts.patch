+// LBPPC: a password nobody will ever type or see (40 characters from the system's secure generator), for accounts
+// whose players sign in with LBPPC account tokens instead.
+QString LbppcRandomPassword() {
+    static const QString chars = QStringLiteral("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789");
+    QString out;
+    out.reserve(40);
+    QRandomGenerator* gen = QRandomGenerator::system();
+    for (int i = 0; i < 40; ++i)
+        out.append(chars.at(gen->bounded(chars.size())));
+    return out;
+}
