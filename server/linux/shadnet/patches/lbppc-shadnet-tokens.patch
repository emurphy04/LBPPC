+// SPDX-License-Identifier: GPL-2.0-or-later
+// LBPPC: signing in to shadNet with an LBPPC account token instead of a password (docs/accounts/DESIGN.md, Phase 2).
+//
+// The launcher signs the player in through lbppc.com (Ory Hydra) and passes the game an access token where the
+// password used to go: "lbppc-token:<token>". shadNet asks Hydra about it (token introspection, on this machine) and
+// accepts it only if Hydra says it is active, was issued to the LBPPC launcher, carries the "game" scope, and names a
+// shadNet account. The token is never stored or logged.
+//
+// The check is a short blocking request: each player's connection runs on its own thread (ShadNetServer::
+// SpawnSession), so it only delays that player's own sign-in. Hydra's admin API is reached only on the loopback
+// address; anything else in LBPPC_HYDRA_ADMIN is refused.
+#pragma once
+
+#include <QByteArray>
+#include <QDebug>
+#include <QHostAddress>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QString>
+#include <QTcpSocket>
+#include <QUrl>
+#include <optional>
+#include <string>
+
+namespace LbppcTokens {
+
+constexpr const char* Prefix = "lbppc-token:";
+constexpr const char* LauncherClient = "lbppc-launcher";
+constexpr int MaxTokenLength = 4096;
+constexpr int TimeoutMs = 3000;
+constexpr qint64 MaxReplyBytes = 64 * 1024;
+
+inline bool IsToken(const std::string& password) {
+    return password.rfind(Prefix, 0) == 0;
+}
+
+/// Hydra's admin API, from LBPPC_HYDRA_ADMIN ("127.0.0.1:4445" by default). Loopback addresses only.
+inline bool AdminAddress(QHostAddress& host, quint16& port) {
+    const QByteArray value = qgetenv("LBPPC_HYDRA_ADMIN");
+    const QString text = value.isEmpty() ? QStringLiteral("127.0.0.1:4445") : QString::fromUtf8(value);
+    const int colon = text.lastIndexOf(':');
+    bool ok = false;
+    port = colon > 0 ? text.mid(colon + 1).toUShort(&ok) : 0;
+    host = QHostAddress(colon > 0 ? text.left(colon) : text);
+    return ok && port != 0 && host.isLoopback();
+}
+
+/// The shadNet user ID an LBPPC token signs in as, or nothing (the reason is logged, never the token).
+inline std::optional<qint64> Verify(const std::string& password) {
+    if (!IsToken(password))
+        return std::nullopt;
+    const std::string token = password.substr(std::char_traits<char>::length(Prefix));
+    if (token.empty() || token.size() > MaxTokenLength) {
+        qWarning() << "LBPPC token: missing or too long";
+        return std::nullopt;
+    }
+    QHostAddress host;
+    quint16 port = 0;
+    if (!AdminAddress(host, port)) {
+        qCritical() << "LBPPC token: LBPPC_HYDRA_ADMIN must be a loopback address and port; token sign-in is off";
+        return std::nullopt;
+    }
+
+    // HTTP/1.0 so the reply ends when the connection closes (no chunked encoding to undo).
+    const QByteArray body = "token=" + QUrl::toPercentEncoding(QString::fromStdString(token)) + "&scope=game";
+    QByteArray request = "POST /admin/oauth2/introspect HTTP/1.0\r\n"
+                         "Host: 127.0.0.1\r\n"
+                         "Content-Type: application/x-www-form-urlencoded\r\n"
+                         "Accept: application/json\r\n"
+                         "Content-Length: " + QByteArray::number(body.size()) + "\r\n\r\n" + body;
+
+    QTcpSocket socket;
+    socket.connectToHost(host, port);
+    if (!socket.waitForConnected(TimeoutMs)) {
+        qWarning() << "LBPPC token: Hydra unreachable:" << socket.errorString();
+        return std::nullopt;
+    }
+    socket.write(request);
+    if (!socket.waitForBytesWritten(TimeoutMs)) {
+        qWarning() << "LBPPC token: sending to Hydra failed";
+        return std::nullopt;
+    }
+    QByteArray reply;
+    while (socket.state() == QAbstractSocket::ConnectedState || socket.bytesAvailable() > 0) {
+        if (socket.bytesAvailable() == 0 && !socket.waitForReadyRead(TimeoutMs))
+            break;
+        reply += socket.readAll();
+        if (reply.size() > MaxReplyBytes) {
+            qWarning() << "LBPPC token: Hydra's reply is too long";
+            return std::nullopt;
+        }
+    }
+
+    const int split = reply.indexOf("\r\n\r\n");
+    if (!reply.startsWith("HTTP/1.") || split < 0) {
+        qWarning() << "LBPPC token: no answer from Hydra";
+        return std::nullopt;
+    }
+    const QList<QByteArray> status = reply.left(reply.indexOf("\r\n")).split(' ');
+    if (status.size() < 2 || status[1] != "200") {
+        qWarning() << "LBPPC token: Hydra answered" << (status.size() > 1 ? status[1] : QByteArray("?"));
+        return std::nullopt;
+    }
+    QJsonParseError error{};
+    const QJsonDocument json = QJsonDocument::fromJson(reply.mid(split + 4), &error);
+    if (error.error != QJsonParseError::NoError || !json.isObject()) {
+        qWarning() << "LBPPC token: Hydra's reply isn't JSON";
+        return std::nullopt;
+    }
+    const QJsonObject o = json.object();
+    if (!o.value("active").toBool()) {
+        qWarning() << "LBPPC token: not active (expired, revoked, unknown, or without the game scope)";
+        return std::nullopt;
+    }
+    if (o.value("client_id").toString() != QLatin1String(LauncherClient) ||
+        o.value("token_use").toString() != QLatin1String("access_token")) {
+        qWarning() << "LBPPC token: not an access token from the LBPPC launcher";
+        return std::nullopt;
+    }
+    const QJsonValue id = o.value("ext").toObject().value("shadnet_user_id");
+    const qint64 userId = id.isDouble() ? static_cast<qint64>(id.toDouble()) : 0;
+    if (userId <= 0 || static_cast<double>(userId) != id.toDouble()) {
+        qWarning() << "LBPPC token: no shadNet account in it";
+        return std::nullopt;
+    }
+    return userId;
+}
+
+} // namespace LbppcTokens
