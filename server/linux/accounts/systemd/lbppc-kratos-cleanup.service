[Unit]
Description=LBPPC accounts: delete Kratos's ended sessions and old sign-in flows after 90 days (privacy page)
After=lbppc-kratos.service

[Service]
Type=oneshot
User=ory-kratos
Group=ory-kratos
ExecStart=/usr/local/bin/kratos cleanup sql -e -c /etc/lbppc/accounts/kratos/kratos.yml -c /etc/lbppc/accounts/kratos/secrets.yml --keep-last 2160h --database.cleanup.batch_size 1000 --database.cleanup.sleep.tables 1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
