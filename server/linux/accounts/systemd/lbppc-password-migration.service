[Unit]
Description=LBPPC accounts: password migration hook (checks old shadNet passwords for Kratos, until the cut-off)
After=network-online.target

[Service]
# lbppc owns shadNet's database; the hook only opens it read-only.
User=lbppc
Group=lbppc
EnvironmentFile=/etc/lbppc/accounts/hook.env
ExecStart=/usr/bin/python3 -I /opt/lbppc-accounts/password_migration_hook.py
Restart=on-failure
RestartSec=5
UMask=0077
MemoryMax=200M

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# The hook opens the database read-only (mode=ro), but SQLite's WAL mode has every reader write the -shm file
# beside it, so this one folder stays writable; everything else on the system is read-only to it.
ReadWritePaths=/srv/lbppc/shadnet/db
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
