{
  "$id": "https://lbppc.com/schemas/identity.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LBPPC account",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "Online name",
          "description": "The name other players see, in the game and on lbppc.com. It's the same as the shadNet name.",
          "minLength": 3,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]{3,16}$",
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "webauthn": { "identifier": true },
              "passkey": { "display_name": true },
              "totp": { "account_name": true }
            }
          }
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email address",
          "maxLength": 254,
          "ory.sh/kratos": {
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        }
      },
      "required": ["username"],
      "additionalProperties": false
    }
  }
}
