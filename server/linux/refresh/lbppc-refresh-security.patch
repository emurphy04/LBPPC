+    // LBPPC: shadNet's admin API on this machine (GET /admin/v1/sessions/check), with its AdminApiKey
+    // from LBPPC_SHADNET_KEY.
+    private static readonly HttpClient ShadNetClient = new() { Timeout = TimeSpan.FromSeconds(5) };
+
+    private static bool ShadNetSessionMatches(RequestContext context, string url, string username, string ipAddress)
+    {
+        if (string.IsNullOrEmpty(url))
+        {
+            context.Logger.LogWarning(BunkumCategory.Authentication, "LBPPC_SHADNET_CHECK_URL isn't set: no game login is accepted");
+            return false;
+        }
+        try
+        {
+            using HttpRequestMessage request = new(HttpMethod.Get,
+                $"{url}?npid={Uri.EscapeDataString(username)}&ip={Uri.EscapeDataString(ipAddress)}");
+            request.Headers.Add("X-Admin-Api-Key", Environment.GetEnvironmentVariable("LBPPC_SHADNET_KEY") ?? "");
+            using HttpResponseMessage response = ShadNetClient.Send(request);
+            if (!response.IsSuccessStatusCode)
+            {
+                context.Logger.LogWarning(BunkumCategory.Authentication, $"shadNet's session check answered {(int)response.StatusCode}");
+                return false;
+            }
+            using Stream stream = response.Content.ReadAsStream();
+            using System.Text.Json.JsonDocument json = System.Text.Json.JsonDocument.Parse(stream);
+            System.Text.Json.JsonElement root = json.RootElement;
+            return root.TryGetProperty("signedIn", out System.Text.Json.JsonElement signedIn) && signedIn.GetBoolean() &&
+                   root.TryGetProperty("sameIp", out System.Text.Json.JsonElement sameIp) && sameIp.GetBoolean();
+        }
+        catch (Exception e)
+        {
+            context.Logger.LogWarning(BunkumCategory.Authentication, $"shadNet's session check failed: {e.Message}");
+            return false;
+        }
+    }
+
+    // LBPPC: shadNet redeems the code (GET /admin/v1/authcodes/redeem, single use) and says whether its session was
+    // this account's, asked for this game server's login.
+    private static bool ShadNetCodeValid(RequestContext context, string code, string username)
+    {
+        string url = Environment.GetEnvironmentVariable("LBPPC_SHADNET_CODES_URL")
+                     ?? "http://127.0.0.1:31350/admin/v1/authcodes/redeem";
+        try
+        {
+            using HttpRequestMessage request = new(HttpMethod.Get,
+                $"{url}?code={Uri.EscapeDataString(code)}&npid={Uri.EscapeDataString(username)}");
+            request.Headers.Add("X-Admin-Api-Key", Environment.GetEnvironmentVariable("LBPPC_SHADNET_KEY") ?? "");
+            using HttpResponseMessage response = ShadNetClient.Send(request);
+            if (!response.IsSuccessStatusCode)
+            {
+                context.Logger.LogWarning(BunkumCategory.Authentication, $"shadNet's code check answered {(int)response.StatusCode}");
+                return false;
+            }
+            using Stream stream = response.Content.ReadAsStream();
+            using System.Text.Json.JsonDocument json = System.Text.Json.JsonDocument.Parse(stream);
+            return json.RootElement.TryGetProperty("valid", out System.Text.Json.JsonElement valid) && valid.GetBoolean();
+        }
+        catch (Exception e)
+        {
+            context.Logger.LogWarning(BunkumCategory.Authentication, $"shadNet's code check failed: {e.Message}");
+            return false;
+        }
+    }
