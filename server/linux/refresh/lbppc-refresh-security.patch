+    // LBPPC: shadNet's admin API on this machine (GET /admin/v1/names/check), with its AdminApiKey from
+    // LBPPC_SHADNET_KEY. LBPPC_SHADNET_CHECK_URL=off (a private test server) turns this off with the login check.
+    private static readonly HttpClient ShadNetClient = new() { Timeout = TimeSpan.FromSeconds(5) };
+
+    /// <summary>Why this name can't have an account here, in words for the player; null when it can.</summary>
+    private static string? LbppcNameProblem(RequestContext context, string username)
+    {
+        if (Environment.GetEnvironmentVariable("LBPPC_SHADNET_CHECK_URL") == "off")
+            return null;
+        string url = Environment.GetEnvironmentVariable("LBPPC_SHADNET_NAMES_URL")
+                     ?? "http://127.0.0.1:31350/admin/v1/names/check";
+        try
+        {
+            using HttpRequestMessage request = new(HttpMethod.Get, $"{url}?npid={Uri.EscapeDataString(username)}");
+            request.Headers.Add("X-Admin-Api-Key", Environment.GetEnvironmentVariable("LBPPC_SHADNET_KEY") ?? "");
+            using HttpResponseMessage response = ShadNetClient.Send(request);
+            if (!response.IsSuccessStatusCode)
+                throw new HttpRequestException($"answered {(int)response.StatusCode}");
+            using Stream stream = response.Content.ReadAsStream();
+            using System.Text.Json.JsonDocument json = System.Text.Json.JsonDocument.Parse(stream);
+            System.Text.Json.JsonElement root = json.RootElement;
+            string blocked = root.TryGetProperty("blocked", out System.Text.Json.JsonElement b) ? b.GetString() ?? "" : "";
+            if (blocked.Length > 0)
+            {
+                context.Logger.LogWarning(BunkumCategory.Authentication,
+                    $"Refused to register {username}: blocked name ({blocked})");
+                return "That name isn't allowed on LBPPC. Please choose another.";
+            }
+            if (!(root.TryGetProperty("exists", out System.Text.Json.JsonElement e) && e.GetBoolean()))
+            {
+                context.Logger.LogWarning(BunkumCategory.Authentication,
+                    $"Refused to register {username}: no LBPPC account by that name");
+                return "Accounts are made in the LBPPC launcher (Online, Create account), which sets this one up too.";
+            }
+            return null;
+        }
+        catch (Exception ex)
+        {
+            context.Logger.LogWarning(BunkumCategory.Authentication, $"shadNet's name check failed: {ex.Message}");
+            return "The account server can't be reached right now. Please try again in a minute.";
+        }
+    }
